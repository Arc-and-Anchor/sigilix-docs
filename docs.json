{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sigilix",
  "colors": {
    "primary": "#f1140d",
    "light": "#ff6a60",
    "dark": "#f1140d"
  },
  "background": {
    "color": {
      "dark": "#09090b",
      "light": "#FAFAF7"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "favicon": "/logo/sigil-favicon.png",
  "logo": {
    "light": "/logo/sigil-wordmark-light.png",
    "dark": "/logo/sigil-wordmark-dark.png",
    "href": "https://sigilix.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "Marketing site",
        "href": "https://sigilix.ai"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/Sigilix"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Join the private beta",
      "href": "https://app.sigilix.ai"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Sigilix"
    }
  },
  "redirects": [
    {
      "source": "/configuration/sigilix-yaml",
      "destination": "/configuration/configuration-reference"
    },
    {
      "source": "/configuration/custom-rules",
      "destination": "/configuration/rules-and-guidance"
    },
    {
      "source": "/configuration/ignore-patterns",
      "destination": "/configuration/path-filters-and-profile"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Platform",
        "icon": "layer-group",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "getting-started/quickstart",
              "getting-started/installation",
              "getting-started/first-review"
            ]
          },
          {
            "group": "How It Works",
            "pages": [
              "how-it-works/the-ensemble",
              "how-it-works/the-dispatcher",
              "how-it-works/specialists",
              "how-it-works/synthesizer",
              "how-it-works/believability-pipeline",
              "how-it-works/deterministic-checks",
              "how-it-works/confidence-scoring",
              "how-it-works/review-lifecycle",
              "how-it-works/review-memory",
              "how-it-works/conversational-learnings",
              "how-it-works/earned-context"
            ]
          },
          {
            "group": "Triage",
            "pages": [
              "triage/overview",
              "triage/issue-triage",
              "triage/ci-failure-triage",
              "triage/how-triage-works"
            ]
          },
          {
            "group": "Evidence & Provenance",
            "pages": [
              "evidence-and-provenance/secret-scanning",
              "evidence-and-provenance/dependency-vulnerabilities",
              "evidence-and-provenance/sarif-evidence",
              "evidence-and-provenance/review-provenance"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/github",
              "integrations/gitlab",
              "integrations/bitbucket"
            ]
          }
        ]
      },
      {
        "tab": "CLI & Deep Research",
        "icon": "terminal",
        "groups": [
          {
            "group": "CLI & Deep Research",
            "pages": [
              "cli-and-chat/overview",
              "cli-and-chat/cli",
              "cli-and-chat/deep-research",
              "cli-and-chat/bring-your-own-models",
              "cli-and-chat/commands"
            ]
          }
        ]
      },
      {
        "tab": "Slack Assistant",
        "icon": "slack",
        "groups": [
          {
